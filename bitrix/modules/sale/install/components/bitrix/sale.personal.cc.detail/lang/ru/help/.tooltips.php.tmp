$MESS ['PATH_TO_LIST_TIP'] = "РЈРєР°Р·С‹РІР°РµС‚СЃСЏ РїСѓС‚СЊ Рє СЃС‚СЂР°РЅРёС†Рµ СЃРѕ СЃРїРёСЃРєРѕРј РїР»Р°СЃС‚РёРєРѕРІС‹С… РєР°СЂС‚. Р•СЃР»Рё СЃС‚СЂР°РЅРёС†Р° РЅР°С…РѕРґРёС‚СЃСЏ РІ С‚РѕР№ Р¶Рµ РґРёСЂРµРєС‚РѕСЂРёРё, С‡С‚Рѕ Рё РґР°РЅРЅР°СЏ, С‚Рѕ РґРѕСЃС‚Р°С‚РѕС‡РЅРѕ СѓРєР°Р·Р°С‚СЊ РЅР°Р·РІР°РЅРёРµ СЃС‚СЂР°РЅРёС†С‹. РўР°РєР°СЏ СЃС‚СЂР°РЅРёС†Р° РјРѕР¶РµС‚ Р±С‹С‚СЊ СЃРѕР·РґР°РЅР° СЃ РїРѕРјРѕС‰СЊСЋ РєРѕРјРїРѕРЅРµРЅС‚Р° <i>РЎРїРёСЃРѕРє РїР»Р°СЃС‚РёРєРѕРІС‹С… РєР°СЂС‚ С‚РµРєСѓС‰РµРіРѕ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ</i>.";
$MESS ['SET_TITLE_TIP'] = "Р’ РєР°С‡РµСЃС‚РІРµ Р·Р°РіРѕР»РѕРІРєР° СЃС‚СЂР°РЅРёС†С‹ РІС‹РІРѕРґРёС‚СЃСЏ \"Р